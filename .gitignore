# ============================================
# Keep these files (override rules)
# ============================================
# Keep empty directories structure
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/samples/.gitkeep
!logs/.gitkeep

# Keep example files
!*.example.py
!*.example.yaml
!config/.env.example

# Keep requirements files
!requirements.txt
!requirements-dev.txt

# Keep documentation
!README.md
!LICENSE
!CONTRIBUTING.md