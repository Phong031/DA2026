# ============================================
# Data files (Sensitive/Large)
# ============================================
# Raw data (large files, sensitive data)
data/raw/
data/processed/
data/samples/
*.csv
*.xlsx
*.xls
*.db
*.sqlite
*.sqlite3

# But keep sample data if needed
!data/samples/README.md
!data/samples/*.sample.csv

