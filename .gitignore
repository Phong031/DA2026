# Logs and Databases
# ============================================
logs/
*.log
*.pid
*.seed
*.pid.lock

# SQLite databases
*.db
*.sqlite
*.sqlite3

# ============================================
# Configuration (with sensitive data)
# ============================================
# Sensitive config files
config/.env
config/local_*.yaml
config/*.local.yaml
config/credentials.yaml
config/*.key
config/*.pem
config/*.cert

# But keep example files
!config/.env.example
!config/*.example.yaml

